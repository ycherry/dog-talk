{
  "expo": {
    "name": "dog-talk",
    "slug": "dog-talk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/dog-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/dog-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dogtalk.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "此应用需要访问您的位置以显示您和宠物在地图上的位置。",
        "NSMicrophoneUsageDescription": "此应用需要访问麦克风以录制宠物与人的声音，用于翻译功能。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "此应用需要访问您的位置以跟踪宠物位置。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/dog-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.dogtalk.app",
      "versionCode": 70,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/dog-icon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "此应用需要访问您的位置以显示您和宠物在地图上的位置。"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d533460f-689c-4e9a-aa39-dbbecb969d8b"
      }
    }
  }
}
